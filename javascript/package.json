{
  "name": "@crawlora-org/duckduckgo",
  "version": "0.1.2",
  "description": "Crawlora DuckDuckGo API client with 6 endpoints for web, news, image, video, and shopping search plus query suggestions",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=duckduckgo-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-duckduckgo/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "duckduckgo", "duckduckgo-api", "duckduckgo-scraper", "duckduckgo-data", "duckduckgo-web", "duckduckgo-news", "duckduckgo-image", "duckduckgo-video", "duckduckgo-shopping-search", "duckduckgo-query-suggestions"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-duckduckgo",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
