  "info": {
    "contact": {
      "email": "support@crawlora.net",
      "name": "API Support",
      "url": "https://crawlora.net"
    },
    "description": "Crawlora is a hosted web-data and SERP API: call documented REST endpoints and get normalized JSON instead of HTML to parse — across search/SERP, maps and local, e-commerce, app stores, social, media and finance. One API key; Crawlora runs the proxy rotation, headless browsers and parsing behind the scenes. Billed pay-on-success: charged only on a successful 2xx response, 1-10 credits per call, with a free tier of 2,000 credits per month and no card. A hosted MCP server (mcp.crawlora.net/mcp) exposes the same catalog as agent tools. Search endpoints accept `q` as a universal alias for whichever search-term parameter they document (`query`, `term`, `keyword`, or Amazon's `k`), so one parameter name works across the whole catalog; an explicitly supplied documented name always wins.",
    "license": {
      "name": "Crawlora Terms of Service",
      "url": "https://crawlora.net/terms"
    },
    "termsOfService": "https://crawlora.net/terms",
    "title": "Crawlora API",
    "version": "1.2",
    "x-logo": {
      "altText": "Crawlora",
      "backgroundColor": "#FFFFFF",
      "url": "https://raw.githubusercontent.com/Crawlora-org/crawlora-mcp/main/assets/logo-400x400.png"
    }
  },
  "paths": {
    "/duckduckgo/image": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "description": "Returns normalized DuckDuckGo image results for a query string: title, source page URL, image URL, thumbnail, dimensions, and hostname, plus page-based pagination. Results are fetched from DuckDuckGo's own image JSON API.",
        "operationId": "duckduckgo-image",
        "parameters": [
          {
            "description": "Search query",
            "in": "query",
            "name": "q",
            "required": true,
            "type": "string",
            "x-example": "openai"
          },
          {
            "description": "1-based page number, defaults to 1",
            "in": "query",
            "name": "page",
            "type": "integer",
            "x-example": 1
          },
          {
            "description": "DuckDuckGo region/locale code, e.g. us-en, uk-en, wt-wt (worldwide, the default)",
            "in": "query",
            "name": "region",
            "type": "string",
            "x-example": "us-en"
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/duckduckgo.imageResponseDoc"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "429": {
            "description": "Too Many Requests",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          },
          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Search DuckDuckGo image results",
        "tags": [
          "duckduckgo"
        ]
      }
    },
